# ---------------------------------------------------------------------------
# Firebase web app config
# Console -> Project settings (gear icon) -> Your apps -> Web app -> SDK setup
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# App Check (required — Firebase AI Logic enforces it)
# Console -> App Check -> Apps -> your web app -> reCAPTCHA v3 -> site key
# On localhost a debug token is used instead; it prints in the browser console
# on first run and must be registered once under App Check -> Manage debug tokens.
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=
